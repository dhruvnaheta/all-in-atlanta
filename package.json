{
  "name": "all-in-atlanta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint js scripts tests backend",
    "format": "prettier --write index.html styles.css js scripts tests backend docs",
    "test:rules": "firebase emulators:exec --project demo-all-in-atlanta --only firestore \"node --test tests/rules.integration.js\"",
    "test:migration": "firebase emulators:exec --project demo-all-in-atlanta --only firestore \"node --test tests/backup.integration.js\"",
    "test:e2e": "firebase emulators:exec --project demo-all-in-atlanta --only firestore,auth,functions \"node --test tests/browser.integration.js\"",
    "test:operations-e2e": "firebase emulators:exec --project demo-all-in-atlanta --only firestore,auth,functions \"node --test tests/operations-browser.integration.js\"",
    "test:accounts": "firebase emulators:exec --project demo-all-in-atlanta --only firestore,auth,functions \"node --test --test-concurrency=1 tests/accounts.integration.js tests/account-browser.integration.js\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0"
  },
  "main": "backend/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "@google-cloud/firestore": "^7.11.6",
    "google-auth-library": "^10.9.1"
  }
}
