{
  "functions": [
    {
      "source": ".",
      "codebase": "league",
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "test-results",
        "playwright-report",
        "assets",
        "index.html",
        "styles.css",
        "preview.png",
        "*-debug.log",
        "backups",
        "scripts",
        ".codex",
        ".agents",
        "README.md",
        "MIGRATION.md"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
